{0.95}\n      />\n    </mesh>\n  );\n}\n\nexport function Sparks({ count, colors, radius = 10 }) {\n  const lines = useMemo(\n    () =>\n      new Array(count).fill().map((_, index) => {\n        const pos = new THREE.Vector3(\n          Math.sin(0) * radius * radiusVariance(),\n          Math.cos(0) * radius * radiusVariance(),\n          Math.sin(0) * Math.cos(0) * radius * radiusVariance(),\n        );\n        const points = new Array(30).fill().map((_, index) => {\n          const angle = (index / 20) * Math.PI * 2;\n\n          return pos\n            .add(\n              new THREE.Vector3(\n                Math.sin(angle) * radius * radiusVariance(),\n                Math.cos(angle) * radius * radiusVariance(),\n                Math.sin(angle) * Math.cos(angle) * radius * radiusVariance(),\n              ),\n            )\n            .clone();\n        });\n        const curve = new THREE.CatmullRomCurve3(points).getPoints(1000);\n        return {\n          // eslint-disable-next-line react-hooks/purity -- Intentional randomness for visual variety during initialization\n          color: colors[parseInt(colors.length * Math.random(), 10)],\n          width: Math.max(0.1, (0.2 * index) / 10),\n          // eslint-disable-next-line react-hooks/purity -- Intentional randomness for visual variety during initialization\n          speed: Math.max(0.001, 0.004 * Math.random()),\n          curve,\n        };\n      }),\n    [count, colors, radius],\n  );\n\n  return (\n    <group position={[-radius * 2, -radius, -10]} scale={[1, 1.3, 1]}>\n      {lines.map((props, index) => (\n        <SparkLine key={index} {...props} />\n      ))}\n    </group>\n  );\n}\n","structuredPatch":[{"oldStart":52,"oldLines":10,"newStart":52,"newLines":8,"lines":["         });","         const curve = new THREE.CatmullRomCurve3(points).getPoints(1000);","         return {","-          // eslint-disable-next-line react-hooks/purity -- Intentional randomness for visual variety during initialization","           color: colors[parseInt(colors.length * Math.random(), 10)],","           width: Math.max(0.1, (0.2 * index) / 10),","-          // eslint-disable-next-line react-hooks/purity -- Intentional randomness for visual variety during initialization","           speed: Math.max(0.001, 0.004 * Math.random()),","           curve,","         };"]}],"userModified":false,"replaceAll":false}}
